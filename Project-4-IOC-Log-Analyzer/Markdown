## 💻 Complete Production Source Code

### 1. Core Automation Script (`analyzer.py`)
This is the main intelligence pipeline that parses data, handles API errors, and formats the triage output table.

```python
import re
import sys
from collections import Counter
import requests
from config import API_KEY

FAILURE_THRESHOLD = 3
ABUSEIPDB_URL = "https://abuseipdb.com"


def extract_ips(log_path):
    """Scan the entire log file and pull out every IPv4 address found."""
    ip_pattern = r"\b(?:\d{1,3}\.){3}\d{1,3}\b"
    ips = []
    with open(log_path, "r") as f:
        for line in f:
            found = re.findall(ip_pattern, line)
            ips.extend(found)
    return ips


def flag_suspicious(ip_list, threshold=FAILURE_THRESHOLD):
    """Count how many times each IP appears; flag those meeting the threshold."""
    counts = Counter(ip_list)
    return {ip: count for ip, count in counts.items() if count >= threshold}


def check_abuseipdb(ip):
    """Query the AbuseIPDB API for the IP's malicious reputation score."""
    headers = {"Key": API_KEY, "Accept": "application/json"}
    params = {"ipAddress": ip, "maxAgeInDays": "90"}
    try:
        response = requests.get(ABUSEIPDB_URL, headers=headers, params=params, timeout=10)
        response.raise_for_status()
        data = response.json()["data"]
        return data.get("abuseConfidenceScore", 0)
    except requests.RequestException as e:
        print(f"  [!] Lookup failed for {ip}: {e}")
        return None


def verdict(score):
    """Translate numerical risk percentages into clear risk categories."""
    if score is None:
        return "UNKNOWN (lookup failed)"
    if score >= 50:
        return "HIGH RISK"
    if score >= 20:
        return "MEDIUM RISK"
    return "LOW RISK"


def main(log_path):
    """Execute the core automation pipeline and output a clean table."""
    print(f"Analyzing {log_path}...\n")
    ips = extract_ips(log_path)
    flagged = flag_suspicious(ips)

    if not flagged:
        print("No IPs met the suspicious activity threshold.")
        return

    print(f"{'IP Address':<20}{'Failed Hits':<15}{'Abuse Score':<18}{'Security Verdict'}")
    print("-" * 70)

    for ip, count in sorted(flagged.items(), key=lambda x: x, reverse=True):
        score = check_abuseipdb(ip)
        # Handle case where score lookup fails or returns None
        score_str = f"{score}%" if score is not None else "None%"
        print(f"{ip:<20}{count:<15}{score_str:<18}{verdict(score)}")


if __name__ == "__main__":
    if len(sys.argv) != 2:
        print("Usage: python3 analyzer.py <path_to_log_file>")
        sys.exit(1)
    main(sys.argv[1])
```

